# =============================================================================
# .gitignore - Forum API Project
# =============================================================================

# ===========================
# Dependencies & Packages
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Uncomment if you want to ignore lock files (not recommended for production)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
.pnpm-debug.log*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ===========================
# Environment Variables (additional hardening)
# ===========================
# Ignore any .env files anywhere
**/.env
**/.env.*

# Ignore environment templates that may accidentally contain real creds
config/environments/*.env

# Explicitly ignore test env file and any envs under config/environments
config/environments/test.env
config/environments/*.local

# Ignore local override files
*.local.env
*.env.local

# Ensure example stays tracked
!.env.example
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# CRITICAL: Development environment files with real credentials
config/environments/development.env
config/environments/.env.development
development.env

# Docker Compose files with hardcoded credentials
docker-compose.dev.yml
docker-compose.override.yml

# Environment configuration files with credentials
config/environments/production.env
config/environments/.env.override

# Any .env files in subdirectories
**/development.env
**/production.env
**/.env.local
**/.env.development
**/.env.production

# ===========================
# Build & Output Directories
# ===========================
dist/
build/
out/
.next/
.nuxt/
.output/
.vercel/
.netlify/

# ===========================
# Logs & Cache
# ===========================
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.eslintcache
.cache/
.parcel-cache/
.nyc_output/
coverage/
*.lcov

# ===========================
# Runtime & Temporary Files
