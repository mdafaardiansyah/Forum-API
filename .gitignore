# Debug files
debug.js
simple-test.js

# SSL certificates (keep structure, ignore actual certificates)
ssl/*.pem
ssl/*.key
ssl/*.crt
config/ssl/certificates/*
!config/ssl/certificates/.gitkeep

# Nginx logs
nginx_logs/
*.access.log
*.error.log

# Database migration backups
migrations/backup/

# Development tools output
tools/output/

